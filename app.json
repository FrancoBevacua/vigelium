{
  "expo": {
    "name": "VIGELIUM",
    "slug": "securia",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "securia",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1F3A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ar.com.securia.app",
      "infoPlist": {
        "NSCameraUsageDescription": "VIGELIUM usa la cámara para adjuntar evidencia fotográfica a los informes de seguridad.",
        "NSPhotoLibraryUsageDescription": "VIGELIUM accede a sus fotos para adjuntar evidencia a los informes.",
        "NSPhotoLibraryAddUsageDescription": "VIGELIUM guarda los informes y fotos que generás.",
        "NSMicrophoneUsageDescription": "VIGELIUM usa el micrófono para que puedas dictar las novedades en vez de escribirlas."
      }
    },
    "android": {
      "versionCode": 9,
      "package": "ar.com.securia.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1F3A"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "allowBackup": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#0B1F3A",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0B1F3A"
          }
        }
      ],
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "VIGELIUM accede a sus fotos para adjuntar evidencia a los informes.",
          "cameraPermission": "VIGELIUM usa la cámara para adjuntar evidencia fotográfica a los informes."
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "VIGELIUM usa el micrófono para que puedas dictar las novedades en vez de escribirlas."
        }
      ],
      "expo-document-picker",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#D93A3A",
          "defaultChannel": "directivas"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "VIGELIUM usa el micrófono para dictar novedades.",
          "speechRecognitionPermission": "VIGELIUM convierte su voz en texto para el Informe general."
        }
      ],
      [
        "react-native-share",
        {
          "android": [
            "com.whatsapp",
            "com.whatsapp.w4b"
          ],
          "ios": [
            "whatsapp"
          ]
        }
      ],
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
